{
    "name": "maazx",
    "displayName": "MaazX Agent",
    "description": "Native VS Code Extension for the MaazX AI Assistant",
    "version": "1.0.0",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Machine Learning"
    ],
    "activationEvents": [],
    "main": "./dist/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "maazx-explorer",
                    "title": "MaazX",
                    "icon": "$(hubot)"
                }
            ]
        },
        "views": {
            "maazx-explorer": [
                {
                    "type": "webview",
                    "id": "maazx.chatView",
                    "name": "Chat"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "lint": "eslint src"
    },
    "devDependencies": {
        "@types/vscode": "^1.80.0",
        "@types/node": "18.x",
        "typescript": "^5.1.3"
    }
}